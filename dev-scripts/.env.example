# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.
#
# Variables set here are loaded automatically by all dev-scripts.
# Any variable already set in your shell takes precedence over this file,
# so CLI overrides still work: ACM_VERSION=2.17 ./setup-upstream-catalog.sh

# ---------------------------------------------------------------------------
# quay.io credentials — required for downstream dev builds (add-pull-secret.sh)
# Get your token at: quay.io → Account Settings → CLI Password → Generate Encrypted Password
# ---------------------------------------------------------------------------
QUAY_USER=rh-ee-yourname
QUAY_TOKEN=your-encrypted-cli-token

# ---------------------------------------------------------------------------
# ACM / MCE versions — used by setup-upstream-catalog.sh and setup-downstream-catalog.sh
# ---------------------------------------------------------------------------
ACM_VERSION=2.16
MCE_VERSION=2.11

# ---------------------------------------------------------------------------
# Downstream catalog tags — used by setup-downstream-catalog.sh
# Defaults to latest-<VERSION> when not set.
# Other formats: v2.16.1  or  2.16.1-DOWNSTREAM-2026-03-30-06-49-38
# ---------------------------------------------------------------------------
#ACM_CATALOG_TAG=latest-2.16
#MCE_CATALOG_TAG=latest-2.11

# ---------------------------------------------------------------------------
# Custom ACM bundle build — used by build-acm-bundle.sh
# INSTALLER_DEV_TOOLS_DIR Local path to the installer-dev-tools checkout, where `just dev-branch-e2e` runs.
# TARGET_CSV_VERSION CSV version to build for the custom ACM bundle (version only, without the ACM CSV name prefix).
# FROM_CSV_VERSION Currently installed ACM CSV that the custom bundle should upgrade from (full CSV name).
# BASE_ACM ACM release branch used for both the operator and bundle source branches.
# BASE_CATALOG_TAG Tag of the base ACM catalog used to build the custom catalog, for example latest-2.17.
# ACM_IMG_TAG Tag for the resulting custom ACM catalog image.
# COMPONENT_BRANCH Which branch in multicluster-observability-operator to use
# (This is what new CSV will be called)
# (These additional images and component-branches correspond to the repository/branch where your rbac changes are made/merged into MCO. For example, for this case, I created a branch off of release-2.17 for MCO, backported the relevant RBAC changes, and then pushed this branch and created an additional image off of this branch)
# (pick latest version of ACM that is currently installed on the cluster)
# (This will be tag of newly created catalog,MCH,bundle images)
# ---------------------------------------------------------------------------
INSTALLER_DEV_TOOLS_DIR=/path/to/installer-dev-tools/scripts/custom-catalog/
TARGET_CSV_VERSION=2.17.4-managedlogstore.1
FROM_CSV_VERSION=advanced-cluster-management.v2.17.3
BASE_ACM=release-2.17
BASE_CATALOG_TAG=latest-2.17.
ACM_IMG_TAG=managed-logstore-test-217-amd64
COMPONENT_BRANCH=multicluster-observability-operator:main

# ---------------------------------------------------------------------------
# Image overrides — used by image-override.sh
# TAG applies to all components built from this repo (see README for the full list).
# REGISTRY defaults to quay.io/stolostron when not set.
# ---------------------------------------------------------------------------
#TAG=2.17.0-SNAPSHOT-2026-04-01-14-59-01
#REGISTRY=quay.io/stolostron
